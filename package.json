{
  "name": "bicycle",
  "devDependencies": {
    "@types/bun": "catalog:",
    "typescript": "catalog:"
  },
  "packageManager": "bun@1.3.8",
  "private": true,
  "scripts": {
    "daemon:dev": "bun --cwd src/daemon dev",
    "daemon:start": "bun --cwd src/daemon start",
    "installer:dev": "bun --cwd src/installer dev",
    "installer:start": "bun --cwd src/installer start"
  },
  "workspaces": {
    "packages": [
      "src/shared",
      "src/installer",
      "src/daemon"
    ],
    "catalog": {
      "@types/bun": "latest",
      "typescript": "^5",
      "hono": "^4.11.5",
      "zod": "^4.4.3",
      "@hono/standard-validator": "^0.2.2",
      "yargs": "^18.0.0",
      "@spader/zargs": "^1.2.0",
      "age-encryption": "^0.3.0",
      "@clack/prompts": "^1.4.0"
    }
  }
}
