{
  "name": "bicycle",
  "devDependencies": {
    "@types/bun": "catalog:",
    "turbo": "^2.8.10",
    "typescript": "catalog:"
  },
  "packageManager": "bun@1.3.8",
  "private": true,
  "bin": {
    "bicycle": "src/daemon/src/index.ts"
  },
  "scripts": {
    "clean": "bun turbo run clean && rm -rf node_modules .turbo",
    "typecheck": "bun turbo run typecheck",
    "build": "bun turbo run build",
    "daemon:dev": "bun --cwd src/daemon dev",
    "daemon:start": "bun --cwd src/daemon start",
    "installer:dev": "bun --cwd src/installer dev",
    "installer:start": "bun --cwd src/installer start"
  },
  "workspaces": {
    "packages": [
      "src/shared",
      "src/datastar",
      "src/installer",
      "src/daemon",
      "src/web",
      "tools"
    ],
    "catalog": {
      "@types/bun": "latest",
      "typescript": "^5",
      "hono": "^4.11.5",
      "zod": "^4.4.3",
      "@hono/standard-validator": "^0.2.2",
      "yargs": "^18.0.0",
      "@spader/zargs": "^1.2.0",
      "age-encryption": "^0.3.0",
      "yaml": "^2.6.0",
      "@clack/prompts": "^1.4.0",
      "pino": "^10.3.1",
      "pino-pretty": "^13.1.3",
      "pino-roll": "^4.0.0"
    }
  }
}
