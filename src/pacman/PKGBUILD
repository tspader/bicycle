pkgname=bicycle
pkgver=0.1.0
pkgrel=1
pkgdesc="Declarative Arch-native machine and container provisioner"
arch=('x86_64')
url="https://github.com/spader/bicycle"
license=('MIT')
depends=('docker' 'docker-compose' 'git')
options=(!strip !debug)
install=bicycle.install

package() {
  install -Dm755 "$startdir/bicycle" \
    "$pkgdir/usr/bin/bicycle"
  install -Dm644 "$startdir/files/bicycle-reconcile.service" \
    "$pkgdir/usr/lib/systemd/system/bicycle-reconcile.service"
  install -Dm644 "$startdir/files/bicycle-reconcile.timer" \
    "$pkgdir/usr/lib/systemd/system/bicycle-reconcile.timer"
  install -Dm644 "$startdir/files/bicycle.yml.example" \
    "$pkgdir/etc/bicycle/bicycle.yml.example"
}
