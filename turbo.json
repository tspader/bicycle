{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "clean": {
      "cache": false
    },
    "typecheck": {
      "dependsOn": [
        "^typecheck"
      ],
      "outputs": []
    },
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": []
    },
    "test": {
      "dependsOn": [],
      "outputs": [],
      "cache": false
    }
  }
}
